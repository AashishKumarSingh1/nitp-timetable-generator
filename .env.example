# =============================================================================
# NIT Patna Timetable & Seating Generator — Environment Configuration
# =============================================================================

# ─── Database Configuration (MySQL / TiDB Cloud / AWS RDS) ────────────────────
# Option A: Single Connection URI (Recommended for Vercel / Cloud deployments)
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE?ssl={"rejectUnauthorized":true}
DATABASE_URL=mysql://user:password@host:3306/timetable_nitp?ssl={"rejectUnauthorized":true}

# Option B: Individual Connection Parameters (Alternative)
# MYSQL_HOST=
# MYSQL_PORT=
# MYSQL_USERNAME=your_mysql_username
# MYSQL_PASSWORD=your_mysql_password
# MYSQL_DATABASE=timetable_nitp
# MYSQL_SSL=true

# ─── Authentication & Security ───────────────────────────────────────────────

JWT_SECRET=your-random-jwt-secret-key-here

# ─── Google Workspace Single Sign-On (Optional OAuth 2.0) ────────────────────
# Create OAuth 2.0 Client Credentials at https://console.cloud.google.com
# Authorized Redirect URIs:
#   Local Dev:   http://localhost:3010/api/auth/google/callback
#   Production:  https://your-domain.vercel.app/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── Server & Application URL ────────────────────────────────────────────────
PORT=3010
# Set public app URL when deployed behind a custom domain or reverse proxy
NEXT_PUBLIC_APP_URL=http://localhost:3010
